# Copy this file to .env and fill it in. The .env file is never committed.

# Where the data lives. Either form works:
#   Host=localhost;Port=54329;Database=edupulse;Username=edupulse
#   postgresql://user:password@host/database?sslmode=require
EDUPULSE_DB=Host=localhost;Port=54329;Database=edupulse;Username=edupulse

# Signs every learner's sign-in. A long random value, 32 characters or more.
EDUPULSE_SECRET=

# AI is optional. With no keys EduPulse still works, by rules: fill-in questions and word-matching marks.
# Gemini reads photos and PDFs, so photo marking needs it. Both have free allowances.
GEMINI_API_KEY=
GROQ_API_KEY=
